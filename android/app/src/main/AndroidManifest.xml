<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_app_logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_app_logo_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HeardApp"
        android:usesCleartextTraffic="true">
        <meta-data
            android:name="com.maxicon.heard.APP_NAME"
            android:value="@string/app_name" />
        <meta-data
            android:name="com.maxicon.heard.APP_DESCRIPTION"
            android:value="@string/app_description" />
        <meta-data
            android:name="com.maxicon.heard.DEVELOPER_NAME"
            android:value="@string/app_developer" />
        <meta-data
            android:name="com.maxicon.heard.DEVELOPER_EMAIL"
            android:value="@string/app_support_email" />
        <meta-data
            android:name="com.maxicon.heard.DEVELOPER_COMPANY"
            android:value="@string/app_branding_company" />
        <meta-data
            android:name="com.maxicon.heard.WEB_CAPTION_PATH"
            android:value="/index.html" />
        <meta-data
            android:name="com.maxicon.heard.ACCESSIBILITY_MODE"
            android:value="retinitis_pigmentosa_reader_pace" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CaptionForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
